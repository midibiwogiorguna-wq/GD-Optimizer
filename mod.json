    },
    "reduce-particles": {
      "type": "bool",
      "name": "Reduce Particles",
      "description": "Reduce supported particle effects.",
      "default": false
    },
    "reduce-glow": {
      "type": "bool",
      "name": "Reduce Glow",
      "description": "Reduce supported glow effects.",
      "default": false
    }
  }
}
