
{
  "geode": "v5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "compgk.gdoptimizer",
  "name": "GD Optimizer",
  "version": "v1.0.0",
  "developer": "CompGk",
  "description": "Android optimization mod focused on smoother Geometry Dash gameplay.",
  "settings": {
    "show-fps": {
      "type": "bool",
      "name": "FPS Monitor",
      "description": "Enable the performance monitor.",
